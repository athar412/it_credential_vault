// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  pinHash      String
  role         String   // "SUPER_ADMIN" | "ADMIN_DIVISI"
  division     String?  // null for SUPER_ADMIN, e.g. "Marketing" for ADMIN_DIVISI
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Credential {
  id                String   @id @default(cuid())
  platform          String
  account           String
  division          String
  role              String
  encryptedPassword String
  iv                String
  authTag           String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  username  String
  targetId  String?
  details   String?
  createdAt DateTime @default(now())
}
